--- !u!114 &1244034928
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1244034927}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f5ed38be5e16a453d8eb758f59d4ab23, type: 3}
  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::GroupProject.Guide.ParrotCompanion
  head: {fileID: 1413307130}
  ai: {fileID: 100644811}
  narrators:
  - {fileID: 886348788}
  - {fileID: 726116275}
  - {fileID: 199814856}
  - {fileID: 632636273}
  - {fileID: 189537390}
  lines:
  - clip: {fileID: 8300000, guid: 47b7d80f5d69642968c1e33da53a2139, type: 3}
    text: Welcome. Take a moment to look around and get comfortable. Let us explore moving forward, backward, and turning.
  - clip: {fileID: 8300000, guid: 99d7a27d0b2e64433bcfc2aa13b042b4, type: 3}
    text: LEFT STICK / FORWARD Push the left stick forward to walk ahead.
  - clip: {fileID: 8300000, guid: 1da2ac3b1c95347e2943913b3b7e3e65, type: 3}
    text: LEFT STICK / BACKWARD Pull the left stick back to move backward.
  - clip: {fileID: 8300000, guid: fd035e74053cd42418b658f3339741f4, type: 3}
    text: LEFT STICK / SIDEWAYS Move it left or right to step sideways.
  - clip: {fileID: 8300000, guid: 82ea0a1ae430c4d53a1cbf3dc1bc4545, type: 3}
    text: RIGHT STICK / TURN Flick left or right to turn in small steps.
  - clip: {fileID: 8300000, guid: d8e0df735b29d47138f2b65cd4542e36, type: 3}
    text: YOUR TURN Walk forward. Turn left at the corner to find the elevator.
  - clip: {fileID: 8300000, guid: 0a5ccc4d64b0745d3b032a8b73cd3802, type: 3}
    text: To push the button, aim at the down arrow and click with the controller trigger.
  - clip: {fileID: 8300000, guid: 061d6f27b7a2f468e8117e0a0fc2e41c, type: 3}
    text: Welcome aboard. Select B one on the cabin panel to go down.
  - clip: {fileID: 8300000, guid: 432863f89d748460599ca537defa68be, type: 3}
    text: Doors closing. Going down to level B one. Please stay inside the cabin.
  - clip: {fileID: 8300000, guid: 45ebbdc3cf50d4b569881485528d64c7, type: 3}
    text: Level B one. You have arrived. The doors are opening. You may leave the elevator.
  voice: {fileID: 1885687242}
  dialogue: {fileID: 1309378463}
  bird: {fileID: 963129606}
  offset: {x: -0.6, y: -0.38, z: 1.65}
